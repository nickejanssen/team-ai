{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nickejanssen/team-ai/schemas/questions.schema.json",
  "title": "Interview question bank",
  "type": "object",
  "additionalProperties": false,
  "required": ["questions"],
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "act", "type", "prompt", "why", "ask_if"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]*$"
        },
        "act": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "type": {
          "type": "string",
          "enum": ["single_select", "multi_select", "text", "confirm", "rank"]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "pattern": "docs/quality-bar\\.md#q(1[0-7]|[1-9])(?![0-9])"
        },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/option" }
        },
        "default": true,
        "recommend": true,
        "recommend_why": {
          "type": "string",
          "minLength": 1
        },
        "allow_defer": { "type": "boolean" },
        "ask_if": {
          "type": "string",
          "minLength": 1
        }
      },
      "dependentRequired": {
        "recommend": ["recommend_why"]
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["single_select", "multi_select", "rank"] }
            }
          },
          "then": {
            "required": ["options"],
            "properties": {
              "options": { "type": "array", "minItems": 1 }
            }
          },
          "else": {
            "properties": {
              "options": { "type": "array", "maxItems": 0 }
            }
          }
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "tradeoff": { "type": "string", "minLength": 1 },
        "implies": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }]
          }
        }
      }
    }
  }
}
