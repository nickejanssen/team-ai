{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nickejanssen/team-ai/schemas/golden.schema.json",
  "title": "Golden eval question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "question",
    "expect_namespace",
    "expect_paths",
    "expect_route",
    "expect_tier_max",
    "must_cite"
  ],
  "properties": {
    "id": { "type": "string" },
    "question": { "type": "string" },
    "expect_namespace": { "type": "string" },
    "expect_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expect_route": { "type": "string" },
    "expect_tier_max": {
      "type": "string",
      "enum": ["none", "small", "large"]
    },
    "must_cite": { "type": "boolean" },
    "source_path": { "type": "string" },
    "generated_on": { "type": "string", "format": "date" },
    "answer_evidence": { "type": "string" }
  }
}
