#!/usr/bin/env node
// Optional, local-only. A thin stdio MCP server that exposes this instance's
// team-ai knowledge commands as tools for a SECOND coding client. It shells out
// to the `team-ai` CLI and parses its stdout; it never imports the framework.
//
// Generated by team-ai for {{team.name}}. Safe to delete if you only use one
// coding client (that client reads the repo directly).

import { execFile } from "node:child_process";
import { promisify } from "node:util";

import { Server } from "@modelcontextprotocol/sdk/server/index.js";
import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
import {
  CallToolRequestSchema,
  ListToolsRequestSchema,
} from "@modelcontextprotocol/sdk/types.js";

const run = promisify(execFile);

// The repo this server was generated into. `team-ai` reads it via `--root`.
const ROOT = new URL(".", import.meta.url).pathname.replace(/\/mcp-server\/$/, "");

// tool name -> argv builder. Every command is read-only and emits JSON or text
// on stdout; the CLI binary is resolved through `npx` so no global install is
// required.
const TOOLS = {
  kb_search: {
    description: "Search the knowledge base and return ranked hits with citations.",
    inputSchema: {
      type: "object",
      properties: { query: { type: "string" }, k: { type: "number" } },
      required: ["query"],
    },
    argv: (a) => ["search", String(a.query), "--json", "--k", String(a.k ?? 8), "--root", ROOT],
  },
  kb_get: {
    description: "Fetch the single best-matching knowledge document for an id or phrase.",
    inputSchema: {
      type: "object",
      properties: { id: { type: "string" } },
      required: ["id"],
    },
    argv: (a) => ["search", String(a.id), "--json", "--k", "1", "--root", ROOT],
  },
  kb_manifest: {
    description: "Report the assembled routing manifest state for this instance.",
    inputSchema: { type: "object", properties: {} },
    argv: () => ["assemble-manifest", "--check", "--root", ROOT],
  },
  kb_coverage_gap: {
    description: "List documents flagged as coverage gaps, stale, orphaned, or unowned.",
    inputSchema: { type: "object", properties: {} },
    argv: () => ["freshness-audit", "--root", `${ROOT}/kb`],
  },
  kb_freshness: {
    description: "Report knowledge-base freshness: stale, orphaned, and unowned documents.",
    inputSchema: { type: "object", properties: {} },
    argv: () => ["freshness-audit", "--root", `${ROOT}/kb`],
  },
};

async function callCli(argv) {
  try {
    const { stdout } = await run("npx", ["--yes", "team-ai", ...argv], {
      cwd: ROOT,
      maxBuffer: 8 * 1024 * 1024,
    });
    const text = stdout.trim();
    try {
      return { ok: true, data: JSON.parse(text) };
    } catch {
      return { ok: true, data: text };
    }
  } catch (err) {
    return { ok: false, error: err && err.message ? err.message : String(err) };
  }
}

const server = new Server(
  { name: "{{team.slug}}-kb-mcp", version: "0.1.0" },
  { capabilities: { tools: {} } },
);

server.setRequestHandler(ListToolsRequestSchema, () => ({
  tools: Object.entries(TOOLS).map(([name, def]) => ({
    name,
    description: def.description,
    inputSchema: def.inputSchema,
  })),
}));

server.setRequestHandler(CallToolRequestSchema, async (request) => {
  const def = TOOLS[request.params.name];
  if (!def) {
    return { isError: true, content: [{ type: "text", text: `unknown tool: ${request.params.name}` }] };
  }
  const result = await callCli(def.argv(request.params.arguments ?? {}));
  const text =
    typeof result.data === "string" ? result.data : JSON.stringify(result.data, null, 2);
  return {
    isError: !result.ok,
    content: [{ type: "text", text: result.ok ? text : `team-ai failed: ${result.error}` }],
  };
});

const transport = new StdioServerTransport();
await server.connect(transport);
